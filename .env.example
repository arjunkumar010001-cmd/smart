# ============================================
# Smart Hiring System - Environment Configuration
# ============================================
# Copy this file to .env and update with your actual values
# NEVER commit .env file to version control!

# ============================================
# CRITICAL SECURITY - REQUIRED
# ============================================
# Generate strong secrets using: python -c "import secrets; print(secrets.token_hex(32))"
# MUST be at least 32 characters - application will fail to start if too short
SECRET_KEY=your-super-secret-key-minimum-32-characters-long-replace-this
JWT_SECRET_KEY=your-jwt-secret-key-minimum-32-characters-long-replace-this

# JWT token expiration (seconds) - default 1 hour
JWT_ACCESS_TOKEN_EXPIRES=3600

# ============================================
# Database Configuration - REQUIRED
# ============================================
# Local MongoDB: mongodb://localhost:27017/
# MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/
MONGODB_URI=mongodb://localhost:27017/
DB_NAME=smart_hiring_db

# ============================================
# CORS Configuration - REQUIRED
# ============================================
# Comma-separated list of allowed origins (NO WILDCARDS in production!)
# Example: https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000

# Frontend URL (for password reset emails and redirects)
FRONTEND_URL=http://localhost:5000

# ============================================
# Email Configuration (Brevo Recommended - Free Tier)
# ============================================
# Sign up at https://brevo.com (free tier: 300 emails/day)
# Get your SMTP key: Transactional > Settings > SMTP & API
#
# For Gmail: Enable 2FA and create App Password
# Guide: https://support.google.com/accounts/answer/185833
SMTP_SERVER=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=your-brevo-login-email@example.com
SMTP_PASSWORD=xsmtpsib-your-brevo-api-key-here
FROM_EMAIL=noreply@yourdomain.com
FROM_NAME=Smart Hiring System
EMAIL_ENABLED=true

# ============================================
# LinkedIn OAuth (Optional - for profile import)
# ============================================
# Get credentials from: https://www.linkedin.com/developers/
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret

# ============================================
# Flask Application Settings
# ============================================
# Development: development | Production: production
FLASK_ENV=development
# Enable debug mode (ONLY for development, set to False in production)
FLASK_DEBUG=True

# ============================================
# Fairness & Bias Prevention
# ============================================
# Threshold values for demographic parity and equal opportunity (0.0-1.0)
DEMOGRAPHIC_PARITY_THRESHOLD=0.1
EQUAL_OPPORTUNITY_THRESHOLD=0.1

# ============================================
# File Upload Configuration
# ============================================
# Max file size in bytes (16777216 = 16MB)
MAX_CONTENT_LENGTH=16777216
# Directory for storing uploaded resumes
UPLOAD_FOLDER=uploads/resumes

# ============================================
# CORS Configuration
# ============================================
# Already configured above - see ALLOWED_ORIGINS and FRONTEND_URL

# ============================================
# DEPLOYMENT LICENSE & AUTHORIZATION (REQUIRED FOR PRODUCTION)
# ============================================
# These variables prevent unauthorized deployments
# Contact admin@smarthiring.com for production license

# Deployment license key (required for production)
DEPLOYMENT_LICENSE_KEY=your-deployment-license-key-here

# Deployment signature (auto-generated from license key)
DEPLOYMENT_SIGNATURE=your-deployment-signature-here

# Authorized domains (comma-separated, no spaces)
AUTHORIZED_DOMAINS=localhost,yourdomain.com

# Current deployment domain
DEPLOYMENT_DOMAIN=localhost

# Skip license check (DEVELOPMENT ONLY - set to 'false' in production)
SKIP_LICENSE_CHECK=true

# Code obfuscation key (for protecting sensitive algorithms)
OBFUSCATION_KEY=your-obfuscation-key-here

# ============================================
# SMART ASSESSMENT — AI & Code Execution APIs
# ============================================

# PRIMARY: Groq API (FREE — LLaMA 3 / Mixtral, no credit card needed)
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# FALLBACK 1: Anthropic Claude (PAID — only used if Groq fails)
# Leave blank to skip. System works fine without it.
ANTHROPIC_API_KEY=

# FALLBACK 2: OpenAI GPT-4o-mini (PAID — only used if both above fail)
# Leave blank to skip. Static fallback questions will be used instead.
OPENAI_API_KEY=

# PRIMARY Code Execution: Piston API (FREE — no API key needed)
# NOTE: The public emkc.org endpoint is whitelist-only since Feb 2026.
# Self-host with Docker for reliable access:
#   docker run -d --name piston -p 2000:2000 ghcr.io/engineer-man/piston
# Then set: PISTON_API_URL=http://localhost:2000/api/v2/piston
# If Piston is unreachable, the system falls back to Judge0 automatically.
PISTON_API_URL=https://emkc.org/api/v2/piston

# FALLBACK Code Execution: Judge0 (100 calls/day free on RapidAPI)
# Leave blank if using Piston only.
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=
JUDGE0_API_HOST=judge0-ce.p.rapidapi.com
JUDGE0_SELF_HOSTED=false

# API Cost Guards (daily call limits per provider)
GROQ_DAILY_LIMIT=500
CLAUDE_DAILY_LIMIT=50
OPENAI_DAILY_LIMIT=50
